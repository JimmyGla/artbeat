# Copy to `.env` and fill in.  `.env` is gitignored, so this file is the only
# record of which variables the client needs — keep it in sync.
#
# Missing Supabase values are NOT a soft failure: src/lib/supabase.ts calls
# createClient() at module load, so the app throws before React mounts and you
# get a blank white screen with no visible error.

# ── Supabase (client-side) ───────────────────────────────────────────────────
# Dashboard → Settings → API.  Use the ANON key, never the service-role key:
# this value ships inside the app bundle and is readable by anyone.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# ── API endpoints ────────────────────────────────────────────────────────────
# VITE_API_URL      → browser build (`npm run dev`).
# VITE_PROD_API_URL → native app (Capacitor.isNativePlatform()).
#
# The native app cannot use localhost: on a physical device that resolves to
# the device itself.  Use your dev machine's LAN address for on-device testing
# (`ipconfig getifaddr en0`), or a deployed HTTPS host for real builds.
#
# Both are baked in at build time — re-run `npm run build:mobile` after edits.
VITE_API_URL=http://localhost:3001
VITE_PROD_API_URL=http://<lan-ip>:3001

# ── Sharing ──────────────────────────────────────────────────────────────────
# Public origin used to build shareable links. Leave empty until the web build
# is deployed: with no value, Share sends the source listing URL instead, which
# at least resolves. It must never fall back to window.location.href — inside
# the native WebView that is capacitor://localhost/... and dead for whoever
# receives it.
VITE_SHARE_BASE_URL=

# ── Notifications ────────────────────────────────────────────────────────────
# Nothing to configure. Closing reminders are *local* notifications: the closing
# date is known when a bookmark is made, so the device schedules them itself —
# no APNs key, no paid Apple Developer account, no server cron, and they fire
# even offline. They are native-only and silently no-op in `npm run dev`, so
# reminders can only be verified in the Simulator or on a device.
#
# Venue alerts ("something new opened at a place you follow") are the opposite:
# the app cannot learn about a new exhibition while closed, so real delivery
# needs push. Until there is a paid account for an APNs key, that list is shown
# in-app on the Saved screen from GET /api/saved/updates. Push becomes a
# delivery channel over that same query, not a rewrite.

# ── Diagnostics ──────────────────────────────────────────────────────────────
# Nothing to configure. Crash reports and product events POST to our own
# /api/telemetry — no third-party SDK, no DSN, no account needed.
#
# The app version in each report is stamped from client/package.json at build
# time (see vite.config.ts), so bump that version when you ship: it is how you
# tell "this crash is new" from "this crash is from an old build".
#
# Users can turn reporting off in Profile → Send diagnostics. Everything is
# scrubbed on the device and again on arrival; see src/lib/telemetry.ts.
#
# To move to a vendor later (Sentry, PostHog), replace the body of `send()` in
# src/lib/telemetry.ts. Every call site stays as it is.
