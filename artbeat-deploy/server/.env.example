# ─── ArtBeat Server — Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Local (docker-compose):  postgresql://artbeat:artbeat@localhost:5432/artbeat
# Railway:                 provided by Railway after adding a PostgreSQL plugin
# Supabase:                Settings → Database → Connection String → URI (use Transaction mode)
DATABASE_URL="postgresql://artbeat:artbeat@localhost:5432/artbeat?schema=public"

# ── Server ────────────────────────────────────────────────────────────────────
# Port the Express server listens on.  Railway/Render inject PORT automatically.
PORT=3001

# ── CORS ──────────────────────────────────────────────────────────────────────
# The URL of your frontend.  Must match exactly (no trailing slash).
# Development:  http://localhost:5173
# Production:   https://artbeat.vercel.app  (your Vercel deployment URL)
CLIENT_URL="http://localhost:5173"

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in your Supabase project: Settings → API
#
# SUPABASE_URL: the project URL, e.g. https://xyzabc.supabase.co
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY: the service-role (secret) key.
# Used server-side only — grants full admin access to auth.
# NEVER expose this key to the client / browser.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SERVICE_ROLE_KEY"

# ── Admin API ─────────────────────────────────────────────────────────────────
# Shared secret for the internal /api/admin/* endpoints.
# Generate with:  openssl rand -hex 32
# Pass as the x-admin-secret header when calling admin routes.
ADMIN_SECRET="change-me-to-a-random-secret"
