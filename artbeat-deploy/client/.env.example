# ─── ArtBeat Client — Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in your values.
# All variables MUST be prefixed with VITE_ to be exposed to the browser bundle.
# NEVER put secrets (service-role keys, admin secrets) in client env vars.

# ── Backend API ───────────────────────────────────────────────────────────────
# Base URL of the Express server — no trailing slash.
# Development:  http://localhost:3001
# Production:   https://artbeat-api.up.railway.app  (your deployed backend URL)
#
# Note: the codebase references this variable as VITE_API_URL.
# Set it here, and also in your Vercel project settings under
# Settings → Environment Variables before deploying.
VITE_API_URL="http://localhost:3001"

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in your Supabase project: Settings → API
#
# VITE_SUPABASE_URL: the project URL (same value as server SUPABASE_URL)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# VITE_SUPABASE_ANON_KEY: the anon/public key.
# Safe to expose — Supabase's Row Level Security protects your data.
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY"
