{
  "name": "artbeat-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "data:refresh": "./scripts/refresh.sh",
    "db:audit": "ts-node --transpile-only scripts/auditData.ts",
    "db:clear-events": "ts-node --transpile-only scripts/clearEvents.ts",
    "db:reconcile": "ts-node --transpile-only scripts/reconcile.ts",
    "db:repair-descriptions": "ts-node --transpile-only scripts/repairDescriptions.ts",
    "db:repair-venues": "ts-node --transpile-only scripts/repairVenues.ts",
    "db:seed-permanent": "ts-node --transpile-only scripts/seedPermanent.ts",
    "db:tag-art-forms": "ts-node --transpile-only scripts/tagArtForms.ts",
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/index.ts",
    "hours:scrape": "npx tsx scripts/scrapeHours.ts",
    "hours:seed": "npx tsx scripts/seedHours.ts",
    "lint": "eslint src scripts --ext .ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node --transpile-only prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "scrape": "ts-node --transpile-only scripts/scrapeEvents.ts",
    "start": "node dist/index.js",
    "telemetry:prune": "npx tsx scripts/telemetryPrune.ts",
    "telemetry:report": "npx tsx scripts/telemetryReport.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.9.1",
    "@supabase/supabase-js": "^2.39.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.4",
    "express": "^4.18.3",
    "prisma": "^5.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.19",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^8.57.1",
    "playwright": "^1.44.0",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.11"
  }
}
